#!/bin/sh
# ============================================================================
# post-commit 钩子 —— 提交后提醒「还有提交未推送」，但 **不自动推送**
#
# 依据《版本更新规范.md》核心原则 5、6：
#   · 推送必须先征得用户同意，禁止自动推送；
#   · 未推送期间所有改动合并为同一个版本，不逐次递增版本号。
#
# 因此本钩子只做统计与提示，**永不联网**。
# 跳过本次提醒：设置环境变量 KAOYAN_NO_PUSH_HINT=1
#
# 设计原则：钩子绝不影响提交本身，任何异常都静默放行。
# ============================================================================

# 显式跳过
if [ -n "$KAOYAN_NO_PUSH_HINT" ]; then
    exit 0
fi

GIT_DIR=$(git rev-parse --git-dir 2>/dev/null) || exit 0

# 分离头指针状态（如正在查看历史提交）不提示
BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
[ -z "$BRANCH" ] && exit 0

# rebase / cherry-pick 过程中的中间提交不提示，等整体完成后再看
if [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ] || [ -d "$GIT_DIR/sequencer" ]; then
    exit 0
fi

SHORT=$(git rev-parse --short HEAD 2>/dev/null)

# 统计未推送的提交数；拿不到上游 ref 时至少按 1 条提示
PENDING=$(git rev-list --count "origin/$BRANCH..HEAD" 2>/dev/null)
[ -z "$PENDING" ] && PENDING=1

echo "" >&2
echo "[待推送] 已提交 $SHORT（仅本地）。当前 origin/$BRANCH 落后 $PENDING 个提交。" >&2
echo "[待推送] 按规范：推送前需先征得用户同意，且这批改动会合并为同一个版本。" >&2
echo "[待推送] 用户同意后执行：  git push origin $BRANCH" >&2
echo "" >&2

exit 0

